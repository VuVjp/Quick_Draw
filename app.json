{
  "expo": {
    "name": "Quick_Draw",
    "slug": "Quick_Draw",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quickdraw",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/logo/logo.png",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "backgroundImage": "./assets/logo/logo.png"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.BeHold.Quick_Draw",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "assets": [
        "./assets/model.tflite",
        "./assets/labels.json"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      "expo-build-properties",
      {
        "android": {
          "packagingOptions": {
            "pickFirst": [
              "**/libnetcompat.so"
            ]
          },
          "extraProguardRules": "-keep class org.tensorflow.lite.** { *; }\n-keep class com.google.android.gms.tflite.** { *; }\n-keep class com.margelo.nitro.** { *; }\n-keepclasseswithmembernames class * {\n    native <methods>;\n}\n-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod"
        }
      },
      "./plugins/withTfliteNoCompress.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true,
          "enableAndroidGPUDelegate": false
        }
      ],
      [
        "expo-assets",
        {
          "assetExtensions": ["tflite"]
        }
      ],
      "expo-audio",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4565f035-4bc5-4e15-83c8-c105a77e240b"
      }
    },
    "owner": "vuvjp123zzz"
  }
}